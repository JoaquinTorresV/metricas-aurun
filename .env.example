# Conexión a Postgres (Easypanel). Ej: postgres://usuario:pass@host:5432/aurun
DATABASE_URL=
# Poner en true si el Postgres exige SSL
PGSSL=false

# Acceso al panel (déjalo vacío en local para entrar sin clave)
DASHBOARD_USER=aurun
DASHBOARD_PASSWORD=

# Puerto (Easypanel lo inyecta; por defecto 3000)
PORT=3000
